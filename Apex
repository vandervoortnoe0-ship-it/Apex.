const LS='codexOS_v4';
let S=load();
function load(){try{const r=localStorage.getItem(LS);if(r)return JSON.parse(r)}catch(e){}return{done:{},fin:[],kpi:[],ev:[],cards:{}}}
function save(){try{localStorage.setItem(LS,JSON.stringify(S))}catch(e){}}
const $=s=>document.querySelector(s);
const iso=d=>d.toISOString().slice(0,10);
const TODAY=iso(new Date());
const dTo=d=>Math.ceil((new Date(d+'T00:00:00')-new Date(TODAY+'T00:00:00'))/864e5);
const app={deck:'fhg_dates',idx:0,order:[],flipped:false,session:0,
init(){$('#hdate').textContent=new Date().toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long'});$('#ev-date').value=TODAY;this.buildChips();this.loadDeck('fhg_dates');this.today();this.agenda();this.fin();this.kpiHist();},
nav(v,el){document.querySelectorAll('.view').forEach(x=>x.classList.remove('on'));document.querySelectorAll('nav button').forEach(x=>x.classList.remove('on'));$('#v-'+v).classList.add('on');el.classList.add('on');document.querySelector('main').scrollTop=0;},
dayType(){if(TODAY==='2026-09-22')return['EXAM_FHG','JOUR J · FHG'];if(TODAY==='2026-09-24')return['EXAM_SCI','JOUR J · SCIENCES'];if(SGS.some(e=>e[0]===TODAY))return['SGS','SGS · EDEGEM'];const evs=S.ev.filter(e=>e.date===TODAY);if(evs.some(e=>e.type==='WORK'))return['WORK','MISSION · TRAVAIL'];const d=new Date().getDay();if(d===1)return['MON','COURS · LUNDI PLEIN'];if(d===0)return['SUN','REVUE · DIMANCHE'];if(d===6)return['SAT','SAMEDI · DW+MISSIONS'];return['WEEK','COURS · MAR-VEN'];},
today(){const[k,label]=this.dayType();const tasks=PROTO[k];$('#dtype').textContent=label;
 const c1=dTo('2026-09-22'),c2=dTo('2026-09-24');$('#cd-fhg').textContent=c1>=0?'J-'+c1:'FAIT';$('#cd-sci').textContent=c2>=0?'J-'+c2:'FAIT';
 const done=S.done[TODAY]||[];let ni=tasks.length-1;for(let i=0;i<tasks.length;i++){if(!done.includes(i)){ni=i;break}}
 const nx=tasks[ni];$('#na-label').textContent=nx[1];$('#na-sub').textContent=(done.length>=tasks.length?'Protocole complet. Récupération.':'Début '+nx[0]+' · '+done.length+'/'+tasks.length+' tâches faites');
 $('#na-tags').innerHTML='<span class="tag wr">'+label+'</span><span class="tag wo">'+tasks.length+' tâches</span><span class="tag ok">'+Math.round(done.length/tasks.length*100)+'%</span>';
 $('#tasks').innerHTML=tasks.map((t,i)=>'<div class="ck '+(done.includes(i)?'done':'')+'" onclick="app.tick('+i+')"><span class="box"></span><span class="tm">'+t[0]+'</span><span class="tx">'+t[1]+'</span></div>').join('');
 const nw=582+S.fin.reduce((a,f)=>a+(f.cat==='DÉPENSE'?-f.amt:f.amt),0);const sgs=S.fin.filter(f=>f.cat==='SGS').reduce((a,f)=>a+f.amt,0);
 $('#s-nw').textContent=nw+'€';$('#s-sgs').textContent=sgs+'€';
 const total=Object.values(DB).reduce((a,d)=>a+d.length,0);const doneC=Object.values(S.cards).reduce((a,c)=>a+(c.done||0),0);const flag=Object.values(S.cards).reduce((a,c)=>a+(c.flagged||[]).length,0);
 const pct=Math.min(100,Math.round(doneC/total*100));$('#m-pct').textContent=pct+'%';$('#m-bar').style.width=pct+'%';$('#m-txt').textContent=doneC+' cartes acquises / '+total+' · '+flag+' en file';},
tick(i){const d=S.done[TODAY]=S.done[TODAY]||[];const p=d.indexOf(i);p<0?d.push(i):d.splice(p,1);save();this.today();},
buildChips(){const names={fhg_dates:'FHG DATES',fhg_outils:'18 OUTILS',fhg_geo:'FHG GÉO',fhg_meth:'FHG MÉTHODE',sci_phy:'SCI PHYS',sci_chi:'SCI CHIM',sci_bio:'SCI BIO',sci_meth:'SCI MÉTHODE'};
 $('#deck-chips').innerHTML=Object.keys(DB).map(k=>'<button class="chip" data-k="'+k+'" onclick="app.loadDeck(\''+k+'\',this)">'+names[k]+'</button>').join('');},
loadDeck(k,el){this.deck=k;this.idx=0;this.session=0;const st=S.cards[k]=S.cards[k]||{flagged:[],done:0};const all=DB[k].map((_,i)=>i);const fl=st.flagged.filter(i=>all.includes(i));this.order=fl.concat(all.filter(i=>!fl.includes(i)));document.querySelectorAll('#deck-chips .chip').forEach(c=>c.classList.toggle('on',c.dataset.k===k));this.renderCard();},
renderCard(){const c=DB[this.deck][this.order[this.idx]];$('#fcard').classList.remove('flip');this.flipped=false;setTimeout(()=>{$('#f-cat').textContent=this.deck.replace('_',' · ').toUpperCase();$('#f-q').textContent=c[0];$('#f-a').textContent=c[1];$('#f-bar').style.width=Math.round(this.idx/this.order.length*100)+'%';$('#f-prog').textContent=(this.idx+1)+' / '+this.order.length+' · session '+this.session+'/10';},160);},
flip(){$('#fcard').classList.toggle('flip');this.flipped=!this.flipped;},
next(ok){const real=this.order[this.idx];const st=S.cards[this.deck];st.flagged=st.flagged.filter(x=>x!==real);if(!ok)st.flagged.push(real);else st.done=(st.done||0)+1;save();this.session++;
 if(this.session>=10){alert('MICRO-SESSION TERMINÉE · 10 cartes. '+st.flagged.length+' en file. Ferme le téléphone.');this.session=0;this.loadDeck(this.deck);this.today();return}
 if(this.idx+1<this.order.length){this.idx++;this.renderCard()}else{this.idx=0;this.loadDeck(this.deck)}},
addEv(){const t=$('#ev-type').value,d=$('#ev-date').value,n=$('#ev-note').value;if(!d)return;S.ev.push({type:t,date:d,note:n});S.ev.sort((a,b)=>a.date<b.date?-1:1);save();$('#ev-note').value='';this.agenda();this.today();},
agenda(){const rows=[];EXAMS.concat(SGS).forEach(e=>{if(dTo(e[0])>=-1)rows.push({d:e[0],l:e[1],t:e[2]})});S.ev.forEach(e=>{if(dTo(e.date)>=-1)rows.push({d:e.date,l:e.note||e.type,t:e.type})});rows.sort((a,b)=>a.d<b.d?-1:1);
 const sgsD=SGS.map(e=>e[0]);
 $('#agd-list').innerHTML=rows.slice(0,18).map(r=>{const cls=r.t==='EXAM'?'wr':r.t==='SGS'?'ok':r.t==='WORK'?'wo':'wo';const warn=(r.t==='WORK'&&sgsD.includes(r.d))?' <span class="tag wr">⚠ CONFLIT SGS</span>':'';const past=dTo(r.d)<0?'opacity:.4;':'';return '<div class="lr" style="'+past+'"><span class="d">'+r.d.slice(5).replace('-','/')+'</span><span style="flex:1">'+r.l+warn+'</span><span class="tag '+cls+'">'+r.t+'</span></div>'}).join('')||'<div class="sub">Rien à venir.</div>';},
addFin(){const a=parseFloat($('#fin-amt').value);if(!a)return;S.fin.push({amt:a,cat:$('#fin-cat').value,d:TODAY});save();$('#fin-amt').value='';this.fin();this.today();},
fin(){$('#fin-list').innerHTML=S.fin.slice(-6).reverse().map(f=>'<div class="lr"><span class="d">'+f.d.slice(5).replace('-','/')+'</span><span style="flex:1">'+f.cat+'</span><span style="color:'+(f.cat==='DÉPENSE'?'var(--red)':'var(--grn)')+';font-weight:800">'+(f.cat==='DÉPENSE'?'-':'+')+f.amt+'€</span></div>').join('')||'<div class="sub">Journal vide.</div>';},
saveKPI(){const v={dw:+$('#k-dw').value||0,sl:+$('#k-sl').value||0,z2:+$('#k-z2').value||0,lg:+$('#k-lg').value||0,pg:+$('#k-pg').value||0};let sc=0;if(v.dw>=15)sc++;if(v.sl>=8)sc++;if(v.z2>=150)sc++;if(v.lg>=5)sc++;if(v.pg>=200)sc++;S.kpi.push(Object.assign({d:TODAY,score:sc},v));save();['k-dw','k-sl','k-z2','k-lg','k-pg'].forEach(i=>$('#'+i).value='');this.kpiHist();alert('SEMAINE ENREGISTRÉE · SCORE '+sc+'/5'+(sc<4?' · vigilance DECISA':''));},
kpiHist(){$('#kpi-hist').innerHTML=S.kpi.slice(-4).reverse().map(k=>'<div class="lr"><span class="d">'+k.d.slice(5).replace('-','/')+'</span><span style="flex:1">DW '+k.dw+'h · som '+k.sl+' · Z2 '+k.z2+'min</span><span class="tag '+(k.score>=4?'ok':'wr')+'">'+k.score+'/5</span></div>').join('');},
backup(){try{navigator.clipboard.writeText(JSON.stringify(S)).then(()=>alert('JSON COPIÉ. Colle-le dans une note sécurisée.'))}catch(e){prompt('Copie manuelle :',JSON.stringify(S))}},
restore(){const t=prompt('Colle le JSON :');if(!t)return;try{S=JSON.parse(t);save();location.reload()}catch(e){alert('JSON invalide.')}},
decisa(o){$('#ovl').classList.toggle('on',!!o)}};
window.onload=()=>app.init();
</script>
